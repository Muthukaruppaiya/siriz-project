# Optional chat API endpoint (server-side AI). Leave empty to use the local trained knowledge base.
# Example Netlify function: /.netlify/functions/chat
VITE_CHAT_API_URL=

# Optional enquiry API. If empty, enquiries are stored in the browser and can be posted later.
# Example: /.netlify/functions/enquiries
VITE_ENQUIRY_API_URL=

# Server-only keys for Netlify/Node functions. Never prefix these with VITE_.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
